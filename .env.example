# ─── Obrigatórias ───────────────────────────────────────────────
# Banco PostgreSQL
DATABASE_URL="postgresql://usuario:senha@host:5432/nidalii?schema=public"
# Endereço público do site, sem barra no final (usado em links de e-mail, SEO e webhooks)
NEXT_PUBLIC_SITE_URL="https://www.seudominio.com.br"
# Segredo para os links de acompanhamento de pedido. Gere com: openssl rand -base64 32
ORDER_LINK_SECRET=""
# Segredo do cron que libera reservas vencidas. Gere com: openssl rand -base64 32
CRON_SECRET=""

# ─── Mercado Pago (Pix, crédito, débito) ───────────────────────
# Credenciais em: mercadopago.com.br/developers > Suas integrações > Credenciais
# Comece com as credenciais de TESTE (começam com TEST-).
MP_ACCESS_TOKEN=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
# Assinatura secreta do webhook (Suas integrações > Webhooks). URL: https://SEU_DOMINIO/api/webhooks/mercadopago
MP_WEBHOOK_SECRET=""

# ─── Melhor Envio (frete) ──────────────────────────────────────
# Token em: melhorenvio.com.br > Integrações > Permissões de acesso (escopo shipping-calculate)
MELHOR_ENVIO_TOKEN=""
# "sandbox" para testes, "production" para valer
MELHOR_ENVIO_ENV="sandbox"
# E-mail técnico exigido pelo Melhor Envio no cabeçalho User-Agent
MELHOR_ENVIO_CONTACT_EMAIL=""

# ─── E-mail transacional (Resend) ──────────────────────────────
RESEND_API_KEY=""
# Remetente de um domínio verificado no Resend, ex.: "Nidalii Store <pedidos@seudominio.com.br>"
EMAIL_FROM=""

# ─── Armazenamento de fotos ────────────────────────────────────
# Na Vercel, conecte um Blob Store ao projeto; BLOB_READ_WRITE_TOKEN é injetado automaticamente.
# Fora da Vercel, as fotos ficam nesta pasta persistente (padrão: storage/uploads no projeto).
# BLOB_READ_WRITE_TOKEN=""
# STORAGE_DIR="/var/data/nidalii/uploads"
